\tCacheWrite: state.TokenUsage.CacheCreationTokens,\n625\t\t\t\tOutput:     state.TokenUsage.OutputTokens,\n626\t\t\t}\n627\t\t}\n628\t\treturn info\n629\t}\n630\t\n631\tfunc writeSessionInfoJSON(w io.Writer, state *strategy.SessionState, status string) error {\n632\t\tenc := json.NewEncoder(w)\n633\t\tenc.SetIndent(\"\", \"  \")\n634\t\tif err := enc.Encode(buildSessionInfoJSON(state, status)); err != nil {\n635\t\t\treturn fmt.Errorf(\"failed to encode session info: %w\", err)\n636\t\t}\n637\t\treturn nil\n638\t}\n639\t\n640\tfunc writeSessionInfoText(w io.Writer, state *strategy.SessionState, status string) error {\n641\t\tfmt.Fprintf(w, \"Session %s\\n\\n\", state.SessionID)\n642\t\n643\t\tagentLabel := string(state.AgentType)\n644\t\tif agentLabel == \"\" {\n645\t\t\tagentLabel = \"(unknown)\"\n646\t\t}\n647\t\tfmt.Fprintf(w, \"Agent:       %s\\n\", agentLabel)\n648\t\tif state.ModelName != \"\" {\n649\t\t\tfmt.Fprintf(w, \"Model:       %s\\n\", state.ModelName)\n650\t\t}\n651\t\n652\t\tfmt.Fprintf(w, \"Status:      %s\\n\", status)\n653\t\n654\t\twt := sessionWorktreeLabel(state)\n655\t\tfmt.Fprintf(w, \"Worktree:    %s\\n\", wt)\n656\t\n657\t\tfmt.Fprintf(w, \"Started:     %s (%s)\\n\",\n658\t\t\tstate.StartedAt.Local().Format(\"2006-01-02 15:04\"), timeAgo(state.StartedAt))\n659\t\n660\t\tif state.EndedAt != nil {\n661\t\t\tfmt.Fprintf(w, \"Ended:       %s (%s)\\n\",\n662\t\t\t\tstate.EndedAt.Local().Format(\"2006-01-02 15:04\"), timeAgo(*state.EndedAt))\n663\t\t}\n664\t\n665\t\tif state.LastInteractionTime != nil {\n666\t\t\tfmt.Fprintf(w, \"Last active: %s (%s)\\n\",\n667\t\t\t\tstate.LastInteractionTime.Local().Format(\"2006-01-02 15:04\"),\n668\t\t\t\ttimeAgo(*state.LastInteractionTime))\n669\t\t}\n670\t\n671\t\tif state.SessionTurnCount \u003e 0 {\n672\t\t\tfmt.Fprintf(w, \"Turns:       %d\\n\", state.SessionTurnCount)\n673\t\t}\n674\t\n675\t\tfmt.Fprintf(w, \"Checkpoints: %d\\n\", state.StepCount)\n676\t\n677\t\tif state.LastCheckpointID != \"\" {\n678