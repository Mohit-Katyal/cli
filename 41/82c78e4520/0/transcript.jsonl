intf(\"session %s has no transcript path recorded\", state.SessionID)\n549\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), msg)\n550\t\t\treturn NewSilentError(errors.New(msg))\n551\t\t}\n552\t\n553\t\tpath, err := strategy.ResolveTranscriptPath(state)\n554\t\tif err != nil {\n555\t\t\tcmd.SilenceUsage = true\n556\t\t\tfmt.Fprintf(cmd.ErrOrStderr(), \"transcript unavailable: %v\\n\", err)\n557\t\t\treturn NewSilentError(fmt.Errorf(\"transcript unavailable: %w\", err))\n558\t\t}\n559\t\n560\t\t// Errors from streaming are runtime issues (Stat failure, mid-write JSON,\n561\t\t// etc.), not flag-usage problems — don't print cobra's usage block on top\n562\t\t// of any partial stdout output.\n563\t\tcmd.SilenceUsage = true\n564\t\treturn streamTranscriptToStdout(ctx, cmd.OutOrStdout(), path, state.AgentType)\n565\t}\n566\t\n567\t// sessionInfoJSON is the JSON output structure for sessions info --json.\n568\ttype sessionInfoJSON struct {\n569\t\tSessionID      string         `json:\"session_id\"`\n570\t\tAgent          string         `json:\"agent\"`\n571\t\tModel          string         `json:\"model,omitempty\"`\n572\t\tStatus         string         `json:\"status\"`\n573\t\tBranch         string         `json:\"branch,omitempty\"`\n574\t\tWorktreeID     string         `json:\"worktree_id,omitempty\"`\n575\t\tWorktreePath   string         `json:\"worktree_path,omitempty\"`\n576\t\tStartedAt      time.Time      `json:\"started_at\"`\n577\t\tEndedAt        *time.Time     `json:\"ended_at,omitempty\"`\n578\t\tLastActive     *time.Time     `json:\"last_active,omitempty\"`\n579\t\tTurns          int            `json:\"turns\"`\n580\t\tCheckpoints    int            `json:\"checkpoints\"`\n581\t\tLastCheckpoint string         `json:\"last_checkpoint_id,omitempty\"`\n582\t\tTokens         *tokenInfoJSON `json:\"tokens,omitempty\"`\n583\t\tLastPrompt     string         `json:\"last_prompt,omitempty\"`\n584\t\tFilesTouched   []string       `json:\"files_touched,omitempty\"`\n585\t}","statu