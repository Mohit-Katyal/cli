shot.URL\n\t}\n\n\tvar b strings.Builder\n\tb.WriteString(\"Linked ticket (original intent the change should satisfy):\\n\")\n\tb.WriteString(\"- \")\n\tb.WriteString(label)\n\tif state != \"\" {\n\t\tfmt.Fprintf(\u0026b, \" (%s)\", state)\n\t}\n\tif title != \"\" {\n\t\tb.WriteString(\": \")\n\t\tb.WriteString(title)\n\t}\n\tif url != \"\" {\n\t\tb.WriteString(\"\\n  \")\n\t\tb.WriteString(url)\n\t}\n\treturn b.String()\n}"},"name":"Edit","result":{"output":"The file /Users/mohit/Desktop/cli/cmd/entire/cli/review_context.go has been updated successfully. (file state is current in your context — no need to Read it back)","status":"success","file":{"filePath":"/Users/mohit/Desktop/cli/cmd/entire/cli/review_context.go"}},"type":"tool_use"}]}
